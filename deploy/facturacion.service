[Unit]
Description=Aplicacion de facturacion (autonomo)
After=network.target

[Service]
Type=simple
User=facturacion
Group=facturacion
WorkingDirectory=/opt/facturacion
Environment=PORT=8080
Environment=HOST=127.0.0.1
Environment=FACTURACION_DATA=/var/lib/facturacion
Environment=FACTURACION_AUTH_FILE=/opt/facturacion/auth.json
ExecStart=/usr/bin/node /opt/facturacion/server.js
Restart=always
RestartSec=5

# Endurecido: el proceso no necesita nada fuera de su directorio de datos.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/facturacion
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# MemoryDenyWriteExecute=true NO: el JIT de V8 (baseline compiler) necesita
# mapear paginas W^X para generar codigo maquina; con esto activado Node
# revienta al arrancar (V8_Fatal en v8::base::OS::SetPermissions), visto en
# despliegue real.

[Install]
WantedBy=multi-user.target
